{
  "name": "unicode-properties",
  "version": "1.4.1",
  "description": "Provides fast access to unicode character properties",
  "type": "module",
  "exports": {
    ".": "./index.js"
  },
  "dependencies": {
    "unicode-trie": "^2.0.0"
  },
  "devDependencies": {
    "codepoints": "^1.3.0",
    "mocha": "^12.0.2"
  },
  "scripts": {
    "test": "mocha",
    "test:browser": "node --conditions=browser ./node_modules/mocha/bin/mocha.js"
  },
  "repository": {
    "type": "git",
    "url": "git://github.com/devongovett/unicode-properties.git"
  },
  "keywords": [
    "unicode",
    "metadata",
    "character",
    "codepoint"
  ],
  "files": [
    "index.js",
    "data.js",
    "binaryTrie.browser.js",
    "binaryTrie.node.js",
    "data.base64.trie.js"
